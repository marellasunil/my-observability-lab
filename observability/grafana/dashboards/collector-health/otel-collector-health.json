{
  "uid": "otel-collector-health",
  "title": "OpenTelemetry | Agent & Gateway Health",
  "description": "Collector internal health and configured telemetry path for Fedora homelab",
  "tags": [
    "opentelemetry",
    "collector",
    "agent",
    "gateway",
    "homelab"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "editable": true,
  "panels": [
    {
      "id": 1,
      "title": "Collector targets UP",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "1 means Prometheus successfully scraped the collector; 0 means scrape failure.",
      "targets": [
        {
          "refId": "A",
          "expr": "up{namespace=\"observability\",endpoint=\"self-metrics\"}",
          "legendFormat": "{{job}} / {{instance}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 5
      }
    },
    {
