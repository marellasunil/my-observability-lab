      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "sum by (device,direction) (rate(system_disk_io_bytes_total{deployment_environment_name=~\"$environment\",host_name=~\"$host\"}[$__rate_interval]))",
          "legendFormat": "{{device}} {{direction}}",
          "refId": "A",
