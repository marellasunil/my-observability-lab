{
  "uid": "fedora-host-otel",
  "title": "Fedora Host Monitoring | OpenTelemetry + Mimir",
  "tags": [
    "opentelemetry",
    "mimir",
    "hostmetrics",
    "homelab"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "environment",
        "label": "Environment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "mimir"
        },
        "definition": "label_values(system_cpu_load_average_1m, deployment_environment_name)",
        "query": {
          "query": "label_values(system_cpu_load_average_1m, deployment_environment_name)",
          "refId": "StandardVariableQuery"
        },
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "sort": 1,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "regex": ""
      },
      {
        "name": "host",
        "label": "Host",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "mimir"
        },
        "definition": "label_values(system_cpu_load_average_1m{deployment_environment_name=~\"$environment\"}, host_name)",
        "query": {
          "query": "label_values(system_cpu_load_average_1m{deployment_environment_name=~\"$environment\"}, host_name)",
          "refId": "StandardVariableQuery"
        },
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "sort": 1,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "regex": ""
      },
      {
        "name": "device",
        "label": "Disk device",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "mimir"
        },
        "definition": "label_values(system_disk_io_bytes_total{deployment_environment_name=~\"$environment\",host_name=~\"$host\"}, device)",
        "query": {
          "query": "label_values(system_disk_io_bytes_total{deployment_environment_name=~\"$environment\",host_name=~\"$host\"}, device)",
          "refId": "StandardVariableQuery"
        },
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "sort": 1,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "regex": ""
      },
      {
        "name": "mountpoint",
        "label": "Mount point",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "mimir"
        },
        "definition": "label_values(system_filesystem_usage_bytes{deployment_environment_name=~\"$environment\",host_name=~\"$host\"}, mountpoint)",
        "query": {
          "query": "label_values(system_filesystem_usage_bytes{deployment_environment_name=~\"$environment\",host_name=~\"$host\"}, mountpoint)",
          "refId": "StandardVariableQuery"
        },
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "sort": 1,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "regex": ""
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "CPU busy %",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "100 * (1 - avg by (host_name) (system_cpu_utilization_ratio{deployment_environment_name=~\"$environment\",host_name=~\"$host\",state=\"idle\"}))",
          "legendFormat": "{{host_name}}",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "value"
      },
      "description": "Busy CPU percent calculated from idle utilization. Values are per host."
    },
    {
      "id": 2,
      "title": "Memory used %",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "100 * max by (host_name) (system_memory_utilization_ratio{deployment_environment_name=~\"$environment\",host_name=~\"$host\",state=\"used\"})",
          "legendFormat": "{{host_name}}",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "value"
      },
      "description": "Memory used state as reported by OTel hostmetrics; not necessarily application memory pressure."
    },
    {
      "id": 3,
      "title": "Load average (1m)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "max by (host_name) (system_cpu_load_average_1m{deployment_environment_name=~\"$environment\",host_name=~\"$host\"})",
          "legendFormat": "{{host_name}}",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "value"
      }
    },
    {
      "id": 4,
      "title": "Logical CPUs",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "max by (host_name) (system_cpu_logical_count{deployment_environment_name=~\"$environment\",host_name=~\"$host\"})",
          "legendFormat": "{{host_name}}",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "value"
      }
    },
    {
      "id": 5,
      "title": "CPU utilization by state",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "100 * max by (host_name,state) (system_cpu_utilization_ratio{deployment_environment_name=~\"$environment\",host_name=~\"$host\"})",
          "legendFormat": "{{host_name}} · {{state}}",
          "refId": "A",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 6,
      "title": "Memory usage by state",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "max by (host_name,state) (system_memory_usage_bytes{deployment_environment_name=~\"$environment\",host_name=~\"$host\"})",
          "legendFormat": "{{host_name}} · {{state}}",
          "refId": "A",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 7,
      "title": "Disk throughput by device / direction",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "sum by (host_name,device,direction) (rate(system_disk_io_bytes_total{deployment_environment_name=~\"$environment\",host_name=~\"$host\",device=~\"$device\"}[$__rate_interval]))",
          "legendFormat": "{{host_name}} · {{device}} · {{direction}}",
          "refId": "A",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "Disk I/O bytes per second by device and direction. Select physical devices to avoid partitions or zram."
    },
    {
      "id": 8,
      "title": "Disk operations per second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "sum by (host_name,device,direction) (rate(system_disk_operations_total{deployment_environment_name=~\"$environment\",host_name=~\"$host\",device=~\"$device\"}[$__rate_interval]))",
          "legendFormat": "{{host_name}} · {{device}} · {{direction}}",
          "refId": "A",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 9,
      "title": "Filesystem usage by mount / state",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "max by (host_name,mountpoint,state) (system_filesystem_usage_bytes{deployment_environment_name=~\"$environment\",host_name=~\"$host\",mountpoint=~\"$mountpoint\"})",
          "legendFormat": "{{host_name}} · {{mountpoint}} · {{state}}",
          "refId": "A",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "Raw filesystem usage by state; choose a mount point to reduce visual clutter. Some mounts may represent the same underlying filesystem."
    },
    {
      "id": 10,
      "title": "Network throughput by interface / direction",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 12,
        "y": 21,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "sum by (host_name,device,direction) (rate(system_network_io_bytes_total{deployment_environment_name=~\"$environment\",host_name=~\"$host\",device!=\"lo\"}[$__rate_interval]))",
          "legendFormat": "{{host_name}} · {{device}} · {{direction}}",
          "refId": "A",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "Rate of received/transmitted bytes per second, excluding loopback (lo)."
    },
    {
      "id": 11,
      "title": "Network errors per second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "sum by (host_name,device,direction) (rate(system_network_errors_total{deployment_environment_name=~\"$environment\",host_name=~\"$host\",device!=\"lo\"}[$__rate_interval]))",
          "legendFormat": "{{host_name}} · {{device}} · {{direction}}",
          "refId": "A",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 12,
      "title": "CPU load (1m / 5m)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 12,
        "y": 29,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "max by (host_name) (system_cpu_load_average_1m{deployment_environment_name=~\"$environment\",host_name=~\"$host\"})",
          "legendFormat": "{{host_name}} · 1m",
          "refId": "A",
          "instant": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "max by (host_name) (system_cpu_load_average_5m{deployment_environment_name=~\"$environment\",host_name=~\"$host\"})",
          "legendFormat": "{{host_name}} · 5m",
          "refId": "B",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    }
  ],
  "description": "GitOps-provisioned Fedora host metrics from OpenTelemetry via Mimir. Multi-host aware, with disk and filesystem filters."
}
