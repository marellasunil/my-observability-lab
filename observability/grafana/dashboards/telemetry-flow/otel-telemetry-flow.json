    {
      "id": 7,
      "title": "Receiver refused / failed points/s",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 18,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (job, receiver) (rate(otelcol_receiver_refused_metric_points{endpoint=\"self-metrics\"}[$__rate_interval]))",
          "legendFormat": "Refused / {{job}} / {{receiver}}",
          "range": true
        },
        {
          "refId": "B",
          "expr": "sum by (job, receiver) (rate(otelcol_receiver_failed_metric_points{endpoint=\"self-metrics\"}[$__rate_interval]))",
          "legendFormat": "Failed / {{job}} / {{receiver}}",
          "range": true
        }
      ],
      "description": "Separate queries preserve refused and failed metrics as distinct series, avoiding duplicate label sets.",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
